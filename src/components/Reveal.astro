---
// A collapsible "hold your answer" panel for activities. In class the
// instructor resolves the block live and this stays closed; a student working
// alone opens it to self-check. Wraps native <details>, styled by Starlight,
// for zero-JS accessibility and keyboard operation. The body is forced visible
// when printing so a printed activity still shows its resolutions.
const { label = 'Reveal the answer' } = Astro.props;
---

<details class="reveal my-4 rounded-md border border-(--sl-color-gray-5) bg-(--sl-color-bg) px-3 py-2">
  <summary class="cursor-pointer text-sm font-semibold text-(--sl-color-white]">{label}</summary>
  <div class="mt-2 pt-2 print:block!">
    <slot />
  </div>
</details>

<style>
  /* Show every reveal's resolution when printing. Older engines honor the
     child's display override (print:!block above); newer engines gate a closed
     <details> body behind the ::details-content pseudo-element with
     content-visibility:hidden, which a descendant's display cannot override, so
     reveal it at the pseudo-element too. */
  @media print {
    .reveal::details-content {
      content-visibility: visible !important;
    }
  }
</style>
